# Local-only defaults. Do not commit .env or real secret values.
OPEN_ESTIA_DATA_DIR=.data
OPEN_ESTIA_BASE_URL=http://127.0.0.1:5073
OPEN_ESTIA_PORT=5073
OPEN_ESTIA_SESSION_HOURS=8
OPEN_ESTIA_COOKIE_SECURE=0
# Optional: otherwise a random local secret is stored in .data/secret.key.
# OPEN_ESTIA_SECRET_KEY=
# No email provider, scheduler or participant authentication is used.
